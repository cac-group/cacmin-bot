[Unit]
Description=Update CAC Admin Bot from its published release
Documentation=https://github.com/cac-group/cacmin-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cacmin-bot-auto-update
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/opt/cacmin-bot
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cacmin-bot-update
